{
  "_comments": {
    "deb_to_other_commands_comments": {
      "arch": "Arch does not install recommends automatically, so there is no extra argument necessary to emulate apt-get's --no-install-recommends. The blank arch dictionary in deb_to_other_commands is necessary to indicate compatibility is complete.",
      "alpine": "Alpine Linux apk has no equivalent to apt-get's --no-recommends. The blank alpine dictionary in deb_to_other_commands is necessary to indicate compatibility is complete."
    },
    "deb_to_other_comments": {
      "alpine": {
        "_info_keys": {
          "bsdutils": "Why crowsnest wants bsdutils rather than coreutils is unclear.",
          "crudini": "Why crowsnest wants crudini is unclear (trivial to reimplement and not packaged on some distros). Maybe reimplement or install manually. Is it just for adding an updater entry in moonraker.conf? If so that is N/A since installed with kiauh patches.",
          "icu": "installed by KlipperScreen install script, and warns to install icu-data-full if you need non-English locales and legacy charset support.",
          "packagekit": "There is no equivalent to packagekit, so apk-tools which is somewhat related there as a dummy."
        },
        "_warning_keys": {
          "pipewire-dev": "removes libyuv (a default package on postmarketOS).",
          "x11-xserver-utils": "has no direct equivalent, but KlipperScreen works fine with the xorg-server which includes similar utils."
        },
        "_warning_values": {
          "python3-*": "done by wildcard in translate_deb_package_name *except* python3-devel which does *not* shorten to the 'py3-' prefix."
        },
        "breaking": {
          "pipewire-libs": {
             "breaks": "pipewire-dev",
             "mitigated_comment": "Using pipewire-dev instead of mpv-dev",
             "required_by": "mpv-dev",
             "required_by_key": "libmpv-dev",
             "satisfies": "mpv-libs pipewire pipewire-dev pipewire-jack wireplumber wireplumber-libs"
          }
        },
